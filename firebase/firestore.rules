rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isMasterEmail() {
      return request.auth.token.email == 'rafaelleaobh@gmail.com' ||
        request.auth.token.email == 'medleaobh@gmail.com';
    }

    // Papel e status vêm do perfil em /users/{email}; não há custom claims configuradas.
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        isMasterEmail() ||
        (hasProfile() && profile().status == 'APPROVED' && profile().role in ['admin', 'owner'])
      );
    }

    // Usuários PENDING/DENIED não leem nem gravam cirurgias.
    function isApproved() {
      return isAuthenticated() && (isMasterEmail() || (hasProfile() && profile().status == 'APPROVED'));
    }

    function owns(data) {
      return isApproved() && data.owner_email == request.auth.token.email;
    }

    match /surgeries/{surgeryId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isAdmin() || owns(request.resource.data);
      allow update: if isAdmin() || (owns(resource.data) && owns(request.resource.data));
      allow delete: if isAdmin() || owns(resource.data);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      // Autocadastro sempre como usuário PENDING, sem equipe nem configuração financeira.
      allow create: if isAdmin() || (
        isAuthenticated()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.auth_uid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.role == 'user'
        && !('team_id' in request.resource.data)
        && !('team_name' in request.resource.data)
        && !('financial_config' in request.resource.data)
      );
      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.email == request.auth.token.email
        && request.resource.data.email == resource.data.email
        && request.resource.data.auth_uid == resource.data.auth_uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'picture', 'crm', 'uf', 'role_title', 'onboarding_completed', 'fcmToken'
        ])
      );
      allow delete: if isAdmin();
    }

    // Credential records are restricted to admins and are never exposed to a normal user.
    match /passwords/{passwordId} {
      allow read, write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /report_templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /electrode_models/{modelId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /learned_categories/{catId} {
      allow read, write: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
