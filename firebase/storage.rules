rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isMasterEmail() {
      return request.auth.token.email == 'rafaelleaobh@gmail.com' ||
        request.auth.token.email == 'medleaobh@gmail.com';
    }

    // Papel e status vêm do perfil no Firestore; não há custom claims configuradas.
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.token.email)).data;
    }

    function isApproved() {
      return isAuthenticated() && (
        isMasterEmail() ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.token.email))
          && profile().status == 'APPROVED')
      );
    }

    function isAdmin() {
      return isApproved() && (isMasterEmail() || profile().role in ['admin', 'owner']);
    }

    match /surgeries/{uid}/{surgeryId}/{allPaths=**} {
      allow read: if isAdmin() || (isApproved() && request.auth.uid == uid);
      allow write: if isAdmin() || (
        isApproved()
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
